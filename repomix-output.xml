  font-weight: 600;
}

.text-display-l {
  font-family: var(--font-display);
  font-size: 40px;
  line-height: 48px;
  letter-spacing: -0.01em;
  font-weight: 600;
}

.text-display-m {
  font-family: var(--font-display);
  font-size: 32px;
  line-height: 40px;
  letter-spacing: -0.01em;
  font-weight: 600;
}

.text-heading-s {
  font-family: var(--font-display);
  font-size: 20px;
  line-height: 28px;
  font-weight: 600;
}

.text-body-l {
  font-size: 18px;
  line-height: 28px;
}

.text-body-m {
  font-size: 16px;
  line-height: 24px;
}

.text-body-s {
  font-size: 14px;
  line-height: 20px;
}

.text-caption {
  font-size: 13px;
  line-height: 18px;
  letter-spacing: 0.04em;
  font-weight: 600;
  text-transform: uppercase;
}

.text-mono-data {
  font-family: var(--font-mono);
  font-size: 13px;
  line-height: 20px;
  font-weight: 500;
}

/* ── Upload box (spec §1.3) ── */
.upload-box {
  width: 100%;
  min-height: 180px;
  height: auto;
  padding: 32px 24px;
  border: 2px dashed var(--border-strong);
  border-radius: 24px;
  background: var(--paper-0);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 12px;
  transition:
    border-color 150ms ease,
    background 150ms ease,
    transform 150ms ease-out,
    box-shadow 150ms ease;
  cursor: pointer;
}

@media (min-width: 640px) {
  .upload-box {
    min-height: 240px;
    padding: 40px 32px;
  }
}

.upload-box:hover {
  border-color: var(--local-500);
  background: var(--local-50);
}

.upload-box.is-cloud:hover {
  border-color: var(--cloud-500);
  background: var(--cloud-50);
}

.upload-box.is-dragover {
  border: 3px solid var(--local-500);
  background: var(--local-50);
  box-shadow: var(--shadow-lg);
  transform: scale(1.01);
}

.upload-box.is-cloud.is-dragover {
  border-color: var(--cloud-500);
  background: var(--cloud-50);
}

.upload-box.is-processing {
  border: 1px solid var(--border);
  cursor: default;
  transform: none;
}

.upload-box.is-error {
  border: 2px solid var(--error-500);
  background: var(--error-50);
  cursor: default;
}

.upload-box.is-success {
  border: 1px solid var(--border);
  cursor: default;
}

/* ── Tool card (spec §1.6) ── */
.tool-card {
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--paper-0);
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 140px;
  transition:
    border-color 150ms ease,
    transform 150ms ease,
    box-shadow 150ms ease,
    background 150ms ease;
  text-align: left;
  width: 100%;
}

@media (min-width: 640px) {
  .tool-card {
    min-height: 160px;
  }
}

.tool-card:hover {
  border-color: var(--ink-300);
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.tool-card:active {
  background: var(--paper-100);
}

@media (min-width: 640px) {
  .tool-card:active {
    background: var(--paper-0);
  }
}

.tool-card__icon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: var(--paper-100);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-900);
  position: relative;
}

.tool-card:hover .tool-card__icon {
  background: var(--local-50);
}

/* ── Buttons (spec §1.4) ── */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48px;
  padding: 0 20px;
  border-radius: 10px;
  background: var(--local-500);
  color: white;
  font-size: 15px;
  font-weight: 600;
  transition:
    background 120ms ease,
    transform 120ms ease;
}

@media (min-width: 640px) {
  .btn-primary {
    height: 44px;
  }
}

.btn-primary:hover {
  background: var(--local-700);
}

.btn-primary:active {
  transform: scale(0.98);
}

.btn-primary:disabled {
  background: var(--ink-300);
  cursor: not-allowed;
}

.btn-primary.is-cloud {
  background: var(--cloud-500);
}

.btn-primary.is-cloud:hover {
  background: var(--cloud-700);
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48px;
  padding: 0 20px;
  border-radius: 10px;
  background: transparent;
  border: 1px solid var(--border-strong);
  color: var(--ink-900);
  font-size: 15px;
  font-weight: 600;
  transition: background 120ms ease;
}

@media (min-width: 640px) {
  .btn-secondary {
    height: 44px;
  }
}

.btn-secondary:hover {
  background: var(--paper-100);
}

/* ── Progress bar (spec §1.3 processing state) ── */
.progress-track {
  width: 100%;
  height: 4px;
  border-radius: 999px;
  background: var(--paper-100);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999px;
  background: var(--local-500);
  transition: width 300ms ease-out;
}

.progress-fill.is-cloud {
  background: var(--cloud-500);
}

/* ── Logo ── */
.logo__wordmark {
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 600;
  line-height: 1;
  color: var(--ink-900);
}

.logo--footer .logo__wordmark {
  font-size: 18px;
  color: var(--paper-0);
}

/* ── Reveal animation ── */
.reveal {
  opacity: 0;
  transform: translateY(20px);
  transition:
    opacity 400ms ease,
    transform 400ms ease;
}

.reveal.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.no-motion .reveal {
  opacity: 1;
  transform: none;
  transition: none;
}
