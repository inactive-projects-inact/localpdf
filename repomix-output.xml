@import "tailwindcss";

/* ── LocalPDF design tokens (spec §0) ── */
:root {
  --ink-900: #13151a;
  --ink-700: #3a3d46;
  --ink-500: #6b6e78;
  --ink-300: #b4b2ac;
  --paper-0: #ffffff;
  --paper-50: #fafaf9;
  --paper-100: #f1f0ed;
  --border: #e3e1dc;
  --border-strong: #c9c7c0;
  --local-50: #e3f6ef;
  --local-500: #0e8f6b;
  --local-700: #0b6b51;
  --cloud-50: #ecf0ff;
  --cloud-500: #4c6fff;
  --cloud-700: #2f49c9;
  --error-50: #fbe7e9;
  --error-500: #d7263d;
  --warning-50: #fff4e0;
  --warning-500: #b66a00;
  --focus-ring: rgba(76, 111, 255, 0.35);
  --nav-h: 72px;
  --nav-h-mobile: 56px;

  /* backward-compatible aliases */
  --background: var(--paper-50);
  --foreground: var(--ink-900);
  --body: var(--ink-700);
  --card: var(--paper-0);
  --muted: var(--ink-500);
  --accent: var(--local-500);
  --accent-dark: var(--local-700);
  --accent-tint: var(--local-50);
  --accent-light: var(--local-50);
  --success: var(--local-500);
  --compress: var(--local-500);

  color-scheme: light;
}

@theme inline {
  --color-ink-900: var(--ink-900);
  --color-ink-700: var(--ink-700);
  --color-ink-500: var(--ink-500);
  --color-ink-300: var(--ink-300);
  --color-paper-0: var(--paper-0);
  --color-paper-50: var(--paper-50);
  --color-paper-100: var(--paper-100);
  --color-border: var(--border);
  --color-border-strong: var(--border-strong);
  --color-local-50: var(--local-50);
  --color-local-500: var(--local-500);
  --color-local-700: var(--local-700);
  --color-cloud-50: var(--cloud-50);
  --color-cloud-500: var(--cloud-500);
  --color-cloud-700: var(--cloud-700);
  --color-error-50: var(--error-50);
  --color-error-500: var(--error-500);
  --color-warning-50: var(--warning-50);
  --color-warning-500: var(--warning-500);
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-body: var(--body);
  --color-card: var(--card);
  --color-muted: var(--muted);
  --color-accent: var(--accent);
  --color-accent-tint: var(--accent-tint);
  --color-accent-light: var(--accent-light);
  --color-success: var(--success);
  --color-compress: var(--compress);
  --color-compress-color: var(--local-500);
  --font-display: var(--font-space-grotesk), sans-serif;
  --font-body: var(--font-inter), sans-serif;
  --font-mono: var(--font-ibm-plex-mono), monospace;
  --font-sans: var(--font-body);
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  --shadow-sm: 0 1px 2px rgba(19, 21, 26, 0.04);
  --shadow-md: 0 4px 12px rgba(19, 21, 26, 0.06);
  --shadow-lg: 0 12px 32px rgba(19, 21, 26, 0.1);
  --max-width-content: 1200px;
}

body {
  background: var(--paper-50);
  color: var(--ink-700);
  font-family: var(--font-body);
}

.hide-scrollbar::-webkit-scrollbar {
  display: none;
}
.hide-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

:focus-visible {
  outline: 2px solid var(--local-500);
  outline-offset: 2px;
  border-radius: 4px;
}

/* ── Layout utilities ── */
.container-content {
  width: 100%;
  max-width: 1200px;
  margin-inline: auto;
  padding-inline: 16px;
}

@media (min-width: 1024px) {
  .container-content {
    padding-inline: 64px;
  }
}

.container-tool {
  width: 100%;
  max-width: 760px;
  margin-inline: auto;
  padding-inline: 16px;
}

/* ── Typography utilities (spec §0.2) ── */
.text-display-xl {
