<file path="app/hooks/useCanvasRenderer.ts">
// ---------------------------------------------------------------------------
// useCanvasRenderer
// Shared hook for all canvas-producing worker paths.
//
// Design:
// - Lazy worker init: worker is created on first request(), not on mount.
// - fileBytes are sliced inside the hook — caller's ArrayBuffer is never detached.
// - ImageBitmaps are closed immediately after blob conversion or direct draw.
// - Object URLs are tracked in a Set; revoked explicitly via revokeUrl() or
//   swept on unmount. Both paths are guarded.
// - Stale-result protection: requestIds not in pendingRequests are discarded.
// - Cancelled results ("cancelled" message) are silently ignored; onError is
//   only called for real failures.
// - Worker is terminated and all tracked URLs revoked on unmount, in that order.
// - React StrictMode safe: lazy init prevents double-worker on double-mount.
// ---------------------------------------------------------------------------

import { useCallback, useEffect, useRef } from "react";
import type { ThumbnailOutboundMessage } from "../lib/thumbnail-worker-protocol";

export type RenderParams = {
  /** Caller-owned job identifier. Used for bulk cancel. */
  jobId: number;
  /** Unique per-request identifier. Use crypto.randomUUID(). */
  requestId: string;
  /** PDF bytes. Hook slices internally — caller's buffer is never detached. */
  fileBytes: ArrayBuffer;
  /** 0-based page index. */
  pageIndex: number;
  /** Target render width in px. */
  targetWidth: number;
  /** Degrees added on top of the page's own rotation. */
  extraRotation?: number;
};

export type RenderResult = {
  requestId: string;
  pageIndex: number;
  /**
   * Object URL ready for <img src>.
   * null when OffscreenCanvas is unavailable — caller must render on main thread.
   */
  url: string | null;
  width: number;
  height: number;
};

export type UseCanvasRendererOptions = {
  onResult: (result: RenderResult) => void;
  onError?: (requestId: string, pageIndex: number, reason: string) => void;
};

export function useCanvasRenderer(options: UseCanvasRendererOptions): {
  request: (params: RenderParams) => void;
  cancel: (jobId: number) => void;
  cancelAll: () => void;
  revokeUrl: (url: string) => void;
} {
  const { onResult, onError } = options;

  // Stable refs so callbacks capture the latest version without being
  // re-registered as effect deps.
  const onResultRef = useRef(onResult);
  onResultRef.current = onResult;
  const onErrorRef = useRef(onError);
  onErrorRef.current = onError;

  const workerRef = useRef<Worker | null>(null);
  /** requestIds that are still pending a result. */
  const pendingRequestsRef = useRef<Set<string>>(new Set());
  /** All live object URLs created by this hook instance. */
  const trackedUrlsRef = useRef<Set<string>>(new Set());

  // ---------------------------------------------------------------------------
  // Worker factory — lazy, called only on first request()
  // ---------------------------------------------------------------------------
  const ensureWorker = useCallback((): Worker => {
    if (workerRef.current) return workerRef.current;

    const w = new Worker(
      new URL("../lib/thumbnailRenderer.worker.ts", import.meta.url),
      { type: "module" },
    );

    w.onmessage = (event: MessageEvent<ThumbnailOutboundMessage>) => {
      const msg = event.data;

      if (msg.type === "THUMBNAIL_RESULT") {
        const { requestId, pageIndex, bitmap, width, height } = msg;

        // Stale-result guard: discard if this requestId is no longer wanted.
        if (!pendingRequestsRef.current.has(requestId)) {
          bitmap?.close();
          return;
        }
        pendingRequestsRef.current.delete(requestId);

        if (!bitmap) {
          // OffscreenCanvas unavailable — signal caller to fall back.
          onResultRef.current({ requestId, pageIndex, url: null, width, height });
          return;
        }

        // Convert ImageBitmap → object URL via a temporary canvas.
        // This keeps the URL lifecycle inside the hook.
        const canvas = document.createElement("canvas");
        canvas.width = bitmap.width;
        canvas.height = bitmap.height;
        const ctx = canvas.getContext("2d");
        if (!ctx) {
          bitmap.close();
          canvas.width = 0;
          canvas.height = 0;
          onResultRef.current({ requestId, pageIndex, url: null, width, height });
          return;
        }
        ctx.drawImage(bitmap, 0, 0);
        bitmap.close();
        canvas.toBlob((blob) => {
          canvas.width = 0;
          canvas.height = 0;
          if (!blob) {
            onResultRef.current({ requestId, pageIndex, url: null, width, height });
            return;
          }
          const url = URL.createObjectURL(blob);
          trackedUrlsRef.current.add(url);
          onResultRef.current({ requestId, pageIndex, url, width, height });
        }, "image/jpeg", 0.85);
      } else if (msg.type === "THUMBNAIL_ERROR") {
        const { requestId, pageIndex, message } = msg;
        pendingRequestsRef.current.delete(requestId);
        // "cancelled" is a normal non-error path — do not forward to onError.
        if (message !== "cancelled") {
          onErrorRef.current?.(requestId, pageIndex, message);
        }
      }
    };

    w.onerror = () => {
      // Worker crashed — silently degrade. Pending requests will time out.
      // Callers see no result, which is handled by their own skeleton state.
    };

    workerRef.current = w;
    return w;
  }, []);

  // ---------------------------------------------------------------------------
  // Public API
  // ---------------------------------------------------------------------------

  const request = useCallback((params: RenderParams) => {
    const { jobId, requestId, fileBytes, pageIndex, targetWidth, extraRotation = 0 } = params;
    const w = ensureWorker();
    pendingRequestsRef.current.add(requestId);
    // Slice before transfer — caller's buffer is never detached.
    const transferBuffer = fileBytes.slice(0);
    w.postMessage(
      {
        type: "THUMBNAIL_RENDER",
        jobId,
        requestId,
        fileBytes: transferBuffer,
        pageIndex,
        targetWidth,
        extraRotation,
      },
      [transferBuffer],
    );
  }, [ensureWorker]);

  const cancel = useCallback((jobId: number) => {
    workerRef.current?.postMessage({ type: "THUMBNAIL_CANCEL", jobId });
    // Remove matching requestIds — they follow the convention `${jobId}-*`.
    const toDelete: string[] = [];
    for (const id of pendingRequestsRef.current) {
      if (id.startsWith(`${jobId}-`)) toDelete.push(id);
    }
    toDelete.forEach((id) => pendingRequestsRef.current.delete(id));
  }, []);

  const cancelAll = useCallback(() => {
    workerRef.current?.postMessage({ type: "THUMBNAIL_CANCEL_ALL" });
    pendingRequestsRef.current.clear();
  }, []);

  const revokeUrl = useCallback((url: string) => {
    URL.revokeObjectURL(url);
    trackedUrlsRef.current.delete(url);
  }, []);

  // ---------------------------------------------------------------------------
  // Unmount cleanup — cancel → terminate → revoke all URLs
  // ---------------------------------------------------------------------------
  useEffect(() => {
    return () => {
      if (workerRef.current) {
        workerRef.current.postMessage({ type: "THUMBNAIL_CANCEL_ALL" });
        workerRef.current.terminate();
        workerRef.current = null;
      }
      pendingRequestsRef.current.clear();
      trackedUrlsRef.current.forEach((url) => URL.revokeObjectURL(url));
      trackedUrlsRef.current.clear();
    };
  }, []);

  return { request, cancel, cancelAll, revokeUrl };
}
</file>

<file path="app/hooks/useMergeWorker.ts">
"use client";

/**
 * useMergeWorker.ts
 *
 * React hook that manages the full lifecycle of the pdfMerge.worker.
 *
 * Lifecycle contract
 * ──────────────────
 * • The worker is created fresh on every merge() call — no reuse.
 * • On completion (COMPLETE / ERROR): the worker is terminated and the ref nulled.
 * • On cancel(): worker.terminate() is called immediately. No message is sent
 *   to the worker first — terminate() is instantaneous and correct for a
 *   stateless, single-use worker.
 * • On component unmount: any running worker is force-terminated.
 *   This prevents zombie workers if the user navigates away mid-merge.
 *
 * State shape
 * ───────────
 * MergeWorkerState is the single object the UI thread reads. It includes
 * every field needed to render progress, errors, and the download trigger.
 *
 * TypeScript
 * ──────────
 * All message handling is fully typed through WorkerOutboundMessage.
 * There are no `as any` casts in this file.
 */

import { useCallback, useEffect, useRef, useState } from "react";
import type {
  MergeFileDescriptor,
  WorkerOutboundMessage,
  FileStage,
} from "../lib/merge-worker-protocol";

// ─── Public state types ───────────────────────────────────────────────────────

export type MergePhase =
  | "idle"
  | "merging"
  | "saving"
  | "done"
  | "error"
  | "cancelled";

/** Granular progress for the file currently being processed. */
export interface CurrentFileProgress {
  fileId: string;
  fileName: string;
  /** 1-based position in the queue. */
  fileIndex: number;
  totalFiles: number;
  stage: FileStage;
  pagesDone: number;
  totalPages: number;
}

/** A file that was skipped during the merge due to a per-file error. */
export interface SkippedFile {
  fileId: string;
  fileName: string;
  reason: "encrypted" | "corrupted" | "empty";
}

export interface MergeWorkerState {
  phase: MergePhase;
  /** How many files have been fully processed (including skipped). */
  completedFiles: number;
  totalFiles: number;
  /** Progress for the file currently under processing. null when idle/done. */
  currentFile: CurrentFileProgress | null;
  /** Set when phase === "done". The Uint8Array holding the merged PDF bytes. */
  resultBytes: Uint8Array | null;
  /** Set when phase === "error". */
  errorMessage: string | null;
  /** Files skipped due to encryption, corruption, or being empty. */
  skippedFiles: SkippedFile[];
  /** Set when estimated peak memory exceeds the safe threshold. */
  memoryWarning: { estimatedBytes: number; availableBytes: number | null } | null;
}

export interface UseMergeWorkerReturn {
  state: MergeWorkerState;
  /** Start a merge. Throws if a merge is already in progress. */
  merge: (files: MergeFileDescriptor[]) => void;
  /** Cancel an in-progress merge. No-op if idle. */
  cancel: () => void;
  /** Reset state back to idle (e.g. to allow merging again). */
  reset: () => void;
}

// ─── Initial state ────────────────────────────────────────────────────────────

const INITIAL_STATE: MergeWorkerState = {
  phase: "idle",
  completedFiles: 0,
  totalFiles: 0,
  currentFile: null,
  resultBytes: null,
  errorMessage: null,
  skippedFiles: [],
  memoryWarning: null,
};

// ─── Hook ─────────────────────────────────────────────────────────────────────

export function useMergeWorker(): UseMergeWorkerReturn {
  const [state, setState] = useState<MergeWorkerState>(INITIAL_STATE);

  /**
   * Holds the active Worker instance.
   * We use a ref (not state) because mutating it must never trigger a
   * re-render — only the state changes should do that.
   */
  const workerRef = useRef<Worker | null>(null);

  // ── Unmount guard ──────────────────────────────────────────────────────────
  // Terminates a running worker when the component unmounts (e.g. navigation).
  // This is the single place that prevents zombie workers.
  useEffect(() => {
    return () => {
      if (workerRef.current) {
        workerRef.current.terminate();
        workerRef.current = null;
      }
    };
  }, []);

  // ── Worker teardown helper ─────────────────────────────────────────────────
  const teardownWorker = useCallback(() => {
    if (workerRef.current) {
      workerRef.current.terminate();
      workerRef.current = null;
    }
  }, []);

  // ── Message handler ────────────────────────────────────────────────────────
  /**
   * Processes every outbound message from the worker.
   * Because we create a fresh worker per merge, there is no risk of
   * stale closures — the handler is bound at creation time.
   */
  const buildMessageHandler = useCallback(
    () => (event: MessageEvent<WorkerOutboundMessage>) => {
      const msg = event.data;

      switch (msg.type) {
        case "FILE_STARTED": {
          setState((prev) => ({
            ...prev,
            totalFiles: msg.totalFiles,
            currentFile: {
              fileId: msg.fileId,
              fileName: msg.fileName,
              fileIndex: msg.fileIndex,
              totalFiles: msg.totalFiles,
              stage: "loading",
              pagesDone: 0,
              totalPages: 0,
            },
          }));
          break;
        }

        case "PROGRESS_UPDATE": {
          setState((prev) => {
            // Guard: ignore stale messages if phase has already moved on
            if (prev.phase !== "merging") return prev;
            return {
              ...prev,
              currentFile: prev.currentFile
                ? {
                    ...prev.currentFile,
                    stage: msg.stage as FileStage,
                    pagesDone: msg.pagesDone,
                    totalPages: msg.totalPages,
                  }
                : prev.currentFile,
            };
          });
          break;
        }

        case "FILE_COMPLETED": {
          setState((prev) => ({
            ...prev,
            completedFiles: msg.fileIndex,
          }));
          break;
        }

        case "PIPELINE_STAGE": {
          if (msg.stage === "saving") {
            setState((prev) => ({
              ...prev,
              phase: "saving",
              currentFile: null,
            }));
          }
          break;
        }

        case "FILE_SKIPPED": {
          setState((prev) => ({
            ...prev,
            completedFiles: msg.fileIndex,
            skippedFiles: [
              ...prev.skippedFiles,
              { fileId: msg.fileId, fileName: msg.fileName, reason: msg.reason },
            ],
          }));
          break;
        }

        case "MEMORY_WARNING": {
          setState((prev) => ({
            ...prev,
            memoryWarning: {
              estimatedBytes: msg.estimatedBytes,
              availableBytes: msg.availableBytes,
            },
          }));
          break;
        }

        case "COMPLETE": {
          teardownWorker();
          // Use functional form to preserve skippedFiles accumulated during the run.
          setState((prev) => ({
            phase: "done",
            completedFiles: 0,
            totalFiles: 0,
            currentFile: null,
            resultBytes: msg.result,
            errorMessage: null,
            skippedFiles: prev.skippedFiles,
            memoryWarning: null,
          }));
          break;
        }

        case "ERROR": {
          teardownWorker();
          setState((prev) => ({
            ...prev,
            phase: "error",
            currentFile: null,
            errorMessage: msg.message,
          }));
          break;
        }

        default: {
          // Exhaustive check — TypeScript will warn if a new message type
          // is added to the protocol but not handled here.
          const _exhaustive: never = msg;
          console.warn("[useMergeWorker] Unhandled worker message:", _exhaustive);
        }
      }
    },
    [teardownWorker],
  );

  // ── merge ──────────────────────────────────────────────────────────────────
  const merge = useCallback(
    (files: MergeFileDescriptor[]) => {
      // Defensive: terminate any leftover worker before creating a new one.
      teardownWorker();

      setState({
        phase: "merging",
        completedFiles: 0,
        totalFiles: files.length,
        currentFile: null,
        resultBytes: null,
        errorMessage: null,
        skippedFiles: [],
        memoryWarning: null,
      });

      const worker = new Worker(
        new URL("../lib/pdfMerge.worker.ts", import.meta.url),
        { type: "module" },
      );

      const handleMessage = buildMessageHandler();

      worker.addEventListener("message", handleMessage);

      // Catch unhandled runtime errors inside the worker (e.g. import failures)
      worker.addEventListener("error", (err: ErrorEvent) => {
        teardownWorker();
        setState((prev) => ({
          ...prev,
          phase: "error",
          currentFile: null,
          errorMessage: err.message || "An unexpected error occurred in the merge worker.",
        }));
      });

      workerRef.current = worker;

      worker.postMessage({ type: "START_MERGE", files, onFileError: "skip" });
    },
    [teardownWorker, buildMessageHandler],
  );

  // ── cancel ─────────────────────────────────────────────────────────────────
  const cancel = useCallback(() => {
    if (!workerRef.current) return;
    // Immediately terminate the worker thread. This is instantaneous —
    // the worker cannot post any further messages after this call.
    // No CANCEL message is sent; worker.terminate() is the correct and
    // complete cancellation mechanism for a stateless Web Worker.
    teardownWorker();
    setState((prev) => ({
      ...prev,
      phase: "cancelled",
      currentFile: null,
    }));
  }, [teardownWorker]);

  // ── reset ──────────────────────────────────────────────────────────────────
  const reset = useCallback(() => {
    teardownWorker();
    setState(INITIAL_STATE);
  }, [teardownWorker]);

  return { state, merge, cancel, reset };
}
</file>

<file path="app/hooks/usePdfDocProxy.ts">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { getPdfjs } from "../lib/pdf-utils";

type PDFDocumentProxy = import("pdfjs-dist").PDFDocumentProxy;
type PDFDocumentLoadingTask = import("pdfjs-dist").PDFDocumentLoadingTask;

export type PdfDocProxyLoadError = {
  reason: "encrypted" | "unsupported-encryption" | "corrupted" | "unknown";
  message: string;
};

function classifyPdfOpenError(error: unknown): PdfDocProxyLoadError {
  const message = error instanceof Error ? error.message : String(error);
  const normalized = message.toLowerCase();

  if (normalized.includes("aes") || normalized.includes("unsupported encryption") || normalized.includes("unsupported security")) {
    return { reason: "unsupported-encryption", message };
  }

  if (normalized.includes("encrypt") || normalized.includes("password") || normalized.includes("decrypt") || normalized.includes("security")) {
    return { reason: "encrypted", message };
  }

  if (message.trim() === "") {
    return { reason: "unknown", message: "Unknown PDF loading error." };
  }

  return { reason: "corrupted", message };
}

function destroyLoadingTask(task: PDFDocumentLoadingTask | null) {
  if (!task) return;
  void task.destroy().catch((error: unknown) => {
    console.warn("[usePdfDocProxy] Failed to destroy PDF loading task.", error);
  });
}

function destroyProxy(proxy: PDFDocumentProxy | null) {
  if (!proxy) return;
  void proxy.destroy().catch((error: unknown) => {
    console.warn("[usePdfDocProxy] Failed to destroy PDF proxy.", error);
  });
}

export function usePdfDocProxy() {
  const proxyRef = useRef<PDFDocumentProxy | null>(null);
  const loadingTaskRef = useRef<PDFDocumentLoadingTask | null>(null);
  const jobIdRef = useRef(0);
  const [isLoading, setIsLoading] = useState(false);
  const [numPages, setNumPages] = useState(0);
  const [loadError, setLoadError] = useState<PdfDocProxyLoadError | null>(null);

  const destroy = useCallback(() => {
    jobIdRef.current += 1;
    destroyLoadingTask(loadingTaskRef.current);
    loadingTaskRef.current = null;
    destroyProxy(proxyRef.current);
    proxyRef.current = null;
    setNumPages(0);
    setLoadError(null);
    setIsLoading(false);
  }, []);

  const load = useCallback((source: File | ArrayBuffer) => {
    const jobId = jobIdRef.current + 1;
    jobIdRef.current = jobId;

    destroyLoadingTask(loadingTaskRef.current);
    loadingTaskRef.current = null;
    destroyProxy(proxyRef.current);
    proxyRef.current = null;
    setNumPages(0);
    setLoadError(null);
    setIsLoading(true);

    void (async () => {
      try {
        const pdfjs = await getPdfjs();
        const sourceBuffer = source instanceof File ? await source.arrayBuffer() : source;
        if (jobIdRef.current !== jobId) return;

        const loadingTask = pdfjs.getDocument({ data: sourceBuffer.slice(0) });
        loadingTaskRef.current = loadingTask;
        const proxy = await loadingTask.promise;

        if (jobIdRef.current !== jobId) {
          destroyProxy(proxy);
          return;
        }

        proxyRef.current = proxy;
        loadingTaskRef.current = null;
        setNumPages(proxy.numPages);
        setIsLoading(false);
      } catch (error) {
        if (jobIdRef.current !== jobId) return;
        loadingTaskRef.current = null;
        proxyRef.current = null;
        setLoadError(classifyPdfOpenError(error));
        setIsLoading(false);
      }
    })();
  }, []);

  useEffect(() => {
    return () => {
      jobIdRef.current += 1;
      destroyLoadingTask(loadingTaskRef.current);
      loadingTaskRef.current = null;
      destroyProxy(proxyRef.current);
      proxyRef.current = null;
    };
  }, []);

  return { proxyRef, isLoading, numPages, loadError, load, destroy };
}
</file>

<file path="app/hooks/usePdfPipelineWorker.ts">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import type {
  PdfPipelineComplete,
  PdfPipelineError,
  PdfPipelineMemoryWarning,
  PdfPipelineProgress,
  PdfPipelineRequest,
  PdfPipelineResponse,
  PdfPipelineTask,
} from "../lib/pdf-pipeline-protocol";

export type PdfPipelineStatus = "idle" | "processing" | "done" | "error" | "cancelled";

export type PdfPipelineResult = {
  blob: Blob | null;
  text: string | null;
  filename: string;
  output: PdfPipelineComplete["output"] | null;
};

export type PdfPipelineState = {
  status: PdfPipelineStatus;
  progress: PdfPipelineProgress | null;
  memoryWarning: PdfPipelineMemoryWarning | null;
  result: PdfPipelineResult;
  error: PdfPipelineError | null;
};

const INITIAL_RESULT: PdfPipelineResult = {
  blob: null,
  text: null,
  filename: "",
  output: null,
};

const INITIAL_STATE: PdfPipelineState = {
  status: "idle",
  progress: null,
  memoryWarning: null,
  result: INITIAL_RESULT,
  error: null,
};

export function usePdfPipelineWorker(createWorker: () => Worker) {
  const [state, setState] = useState<PdfPipelineState>(INITIAL_STATE);
  const workerRef = useRef<Worker | null>(null);
  const activeJobIdRef = useRef(0);

  const terminateWorker = useCallback(() => {
    workerRef.current?.terminate();
    workerRef.current = null;
  }, []);

  const reset = useCallback(() => {
    activeJobIdRef.current += 1;
    terminateWorker();
    setState(INITIAL_STATE);
  }, [terminateWorker]);

  const cancel = useCallback(() => {
    const worker = workerRef.current;
    if (!worker) return;
    const jobId = activeJobIdRef.current;
    const cancelMessage: PdfPipelineRequest = { type: "CANCEL", jobId };
    worker.postMessage(cancelMessage);
    activeJobIdRef.current += 1;
    terminateWorker();
    setState((current) => ({ ...current, status: "cancelled", progress: null }));
  }, [terminateWorker]);

  const process = useCallback(
    async (file: File, task: PdfPipelineTask) => {
      const jobId = activeJobIdRef.current + 1;
      activeJobIdRef.current = jobId;
      terminateWorker();
      setState({
        status: "processing",
        progress: { type: "PROGRESS", jobId, phase: "reading", percent: 0, message: "Reading file..." },
        memoryWarning: null,
        result: INITIAL_RESULT,
        error: null,
      });

      try {
        const fileBytes = await file.arrayBuffer();
        if (activeJobIdRef.current !== jobId) return;

        const worker = createWorker();
        workerRef.current = worker;

        worker.onmessage = (event: MessageEvent<PdfPipelineResponse>) => {
          const message = event.data;
          if (message.jobId !== activeJobIdRef.current) return;

          if (message.type === "PROGRESS") {
            setState((current) => ({ ...current, progress: message }));
            return;
          }

          if (message.type === "MEMORY_WARNING") {
            setState((current) => ({ ...current, memoryWarning: message }));
            return;
          }

          if (message.type === "CANCELLED") {
            terminateWorker();
            setState((current) => ({ ...current, status: "cancelled", progress: null }));
            return;
          }

          if (message.type === "ERROR") {
            terminateWorker();
            setState((current) => ({ ...current, status: "error", progress: null, error: message }));
            return;
          }

          terminateWorker();
          if (message.output.kind === "text" || message.output.kind === "file") {
            const buffer = message.output.bytes.buffer.slice(
              message.output.bytes.byteOffset,
              message.output.bytes.byteOffset + message.output.bytes.byteLength,
            ) as ArrayBuffer;
            const blob = new Blob([buffer], { type: message.output.mimeType });
            const text = message.output.kind === "text" ? new TextDecoder().decode(message.output.bytes) : null;
            setState((current) => ({
              ...current,
              status: "done",
              progress: null,
              result: {
                blob,
                text,
                filename: message.output.filename,
                output: message.output,
              },
            }));
            return;
          }

          setState((current) => ({
            ...current,
            status: "done",
            progress: null,
            result: {
              blob: null,
              text: null,
              filename: message.output.filename,
              output: message.output,
            },
          }));
        };

        worker.onerror = (event) => {
          if (activeJobIdRef.current !== jobId) return;
          terminateWorker();
          setState((current) => ({
            ...current,
            status: "error",
            progress: null,
            error: {
              type: "ERROR",
              jobId,
              code: "unknown",
              message: event.message || "Worker failed.",
              recoverable: true,
            },
          }));
        };

        const message: PdfPipelineRequest = {
          type: "START",
          jobId,
          input: {
            fileBytes,
            fileName: file.name,
            fileSize: file.size,
          },
          task,
        };
        worker.postMessage(message, [fileBytes]);
      } catch {
        if (activeJobIdRef.current !== jobId) return;
        setState((current) => ({
          ...current,
          status: "error",
          progress: null,
          error: {
            type: "ERROR",
            jobId,
            code: "unknown",
            message: "Could not read file for processing.",
            recoverable: true,
          },
        }));
      }
    },
    [createWorker, terminateWorker],
  );

  useEffect(() => {
    return () => {
      activeJobIdRef.current += 1;
      terminateWorker();
    };
  }, [terminateWorker]);

  return {
    ...state,
    process,
    cancel,
    reset,
  };
}
</file>

<file path="app/hooks/useProcessorWorker.ts">
import { useCallback, useEffect, useRef, useState } from "react";
import type {
  ProcessorInboundMessage,
  ProcessorOutboundMessage,
  ProcessorTaskOptions,
} from "../lib/pdf-processor-protocol";

interface ProcessorWorkerState {
  status: "idle" | "processing" | "done" | "error";
  progress: number;
  message: string;
  resultBlob: Blob | null;
  resultFilename: string | null;
  error: string | null;
}

export function useProcessorWorker() {
  const [state, setState] = useState<ProcessorWorkerState>({
    status: "idle",
    progress: 0,
    message: "",
    resultBlob: null,
    resultFilename: null,
    error: null,
  });

  const workerRef = useRef<Worker | null>(null);
  const currentJobIdRef = useRef<number>(0);

  useEffect(() => {
    workerRef.current = new Worker(new URL("../lib/pdf-processor.worker.ts", import.meta.url), {
      type: "module",
    });

    workerRef.current.onmessage = (e: MessageEvent<ProcessorOutboundMessage>) => {
      const msg = e.data;
      if (msg.jobId !== currentJobIdRef.current) return; // Ignore stale messages

      if (msg.type === "PROGRESS") {
        setState((s) => ({ ...s, progress: msg.percent, message: msg.message || s.message }));
      } else if (msg.type === "ERROR") {
        setState((s) => ({ ...s, status: "error", error: msg.error, progress: 0 }));
      } else if (msg.type === "COMPLETE") {
        const type = msg.isZip ? "application/zip" : "application/pdf";
        const blob = new Blob([new Uint8Array(msg.result)], { type });
        setState((s) => ({ ...s, status: "done", resultBlob: blob, progress: 100, message: "Done!" }));
      }
    };

    return () => {
      workerRef.current?.terminate();
      workerRef.current = null;
    };
  }, []);

  const process = useCallback(
    async (file: File | null, task: ProcessorTaskOptions, outputFilename: string) => {
      const jobId = ++currentJobIdRef.current;
      setState({
        status: "processing",
        progress: 0,
        message: "Starting...",
        resultBlob: null,
        resultFilename: outputFilename,
        error: null,
      });

      try {
        const fileBytes = file ? await file.arrayBuffer() : new ArrayBuffer(0);
        if (workerRef.current) {
          const msg: ProcessorInboundMessage = {
            type: "START_PROCESS",
            jobId,
            fileBytes,
            task,
          };
          workerRef.current.postMessage(msg, [fileBytes]); // transfer the array buffer
        }
      } catch (err) {
        setState((s) => ({
          ...s,
          status: "error",
          error: "Could not read file for processing.",
        }));
      }
    },
    []
  );

  const cancel = useCallback(() => {
    if (workerRef.current && state.status === "processing") {
      currentJobIdRef.current++; // Invalidate the current job immediately
      const msg: ProcessorInboundMessage = { type: "CANCEL_PROCESS" };
      workerRef.current.postMessage(msg);
      setState((s) => ({ ...s, status: "idle", progress: 0, message: "Cancelled." }));
    }
  }, [state.status]);

  const reset = useCallback(() => {
    setState({
      status: "idle",
      progress: 0,
      message: "",
      resultBlob: null,
      resultFilename: null,
      error: null,
    });
  }, []);

  return {
    ...state,
    process,
    cancel,
    reset,
  };
}
</file>

