    window.addEventListener("keydown", handler);
    return () => window.removeEventListener("keydown", handler);
  }, [handleDownload, result]);

  const reset = useCallback(() => {
    resetPipeline();
    setActiveOperation("idle");
    setFile(null);
    setResult(null);
    setPageCount(0);
    setStep("upload");
  }, [resetPipeline]);

