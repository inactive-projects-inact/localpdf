  tool: HomeToolId;
  delay: number;
  icon: React.ReactNode;
  onSelect: (tool: HomeToolId) => void;
}

function FeatureTile({ tool, delay, icon, onSelect }: TileProps) {
  const router = useRouter();
  const definition = orderedHomeTools.find((item) => item.id === tool);
