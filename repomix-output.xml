            <div className="mt-6">
              <p className="text-sm font-semibold text-foreground">OCR Accuracy Mode</p>
              <div className="mt-3 grid gap-3 sm:grid-cols-3">
                {[
                  ["fast", "Fast", "1x DPR canvas"],
                  ["balanced", "Balanced", "2x DPR canvas"],
