      <div className="progress-track">
        <div
          className={`progress-fill ${mode === "cloud" ? "is-cloud" : ""}`}
          style={{ width: `${clamped}%` }}
          role="progressbar"
          aria-valuenow={clamped}
          aria-valuemin={0}
          aria-valuemax={100}
        />
      </div>
    </div>
  );
}
