import * as XLSX from "xlsx";
import { PDFDocument, StandardFonts, rgb } from "pdf-lib";

type PageSize = "A4" | "A3" | "Letter" | "Legal";
type FontSize = "small" | "medium" | "large";
type Orientation = "landscape" | "portrait";

type LoadMessage = { type: "LOAD"; jobId: number; fileBytes: ArrayBuffer };
type ConvertMessage = {
  type: "CONVERT";
  jobId: number;
  sheetsToConvert: string[];
  orientation: Orientation;
  pageSize: PageSize;
  fontSize: FontSize;
  includeSheetTitle: boolean;
};
type WorkerMessage = LoadMessage | ConvertMessage | { type: "RESET" };

const PAGE_DIMS: Record<PageSize, { width: number; height: number }> = {
  A4: { width: 595, height: 842 },
  A3: { width: 842, height: 1191 },
  Letter: { width: 612, height: 792 },
  Legal: { width: 612, height: 1008 },
};

const FONT_SIZES: Record<FontSize, number> = {
  small: 8,
  medium: 10,
  large: 12,
};

let workbook: XLSX.WorkBook | null = null;

function postError(jobId: number, error: unknown) {
  self.postMessage({ type: "ERROR", jobId, error: error instanceof Error ? error.message : "Spreadsheet conversion failed." });
}

self.onmessage = async (e: MessageEvent<WorkerMessage>) => {
  const message = e.data;
  if (message.type === "RESET") {
    workbook = null;
    return;
  }

  try {
    if (message.type === "LOAD") {
      workbook = XLSX.read(message.fileBytes, { type: "array" });
      const sheetNames = workbook.SheetNames.filter((name) => Boolean(workbook?.Sheets[name]));
      if (sheetNames.length === 0) throw new Error("No readable sheets found in this workbook.");
      self.postMessage({ type: "LOADED", jobId: message.jobId, sheetNames });
      return;
    }

    if (!workbook) throw new Error("Spreadsheet is not loaded. Choose the file again.");
    const pdfDoc = await PDFDocument.create();
    const regularFont = await pdfDoc.embedFont(StandardFonts.Helvetica);
    const boldFont = await pdfDoc.embedFont(StandardFonts.HelveticaBold);

    const dims = PAGE_DIMS[message.pageSize];
    const pgW = message.orientation === "landscape" ? dims.height : dims.width;
    const pgH = message.orientation === "landscape" ? dims.width : dims.height;
    const fSize = FONT_SIZES[message.fontSize];
    const margin = 40;
    const rowH = fSize + 8;
    const headerH = rowH + 4;
    let writtenSheets = 0;

    for (const sheetName of message.sheetsToConvert) {
      const ws = workbook.Sheets[sheetName];
      if (!ws) continue;

      const rows = XLSX.utils.sheet_to_json<unknown[]>(ws, { header: 1, defval: "" })
        .map((row) => row.map((cell) => String(cell ?? "")));
      if (rows.length === 0) continue;
      if (!rows.some((row) => row.some((cell) => cell.trim().length > 0))) continue;

      const colCount = Math.max(...rows.map((row) => row.length));
      if (colCount === 0) continue;

      const colWidths: number[] = Array(colCount).fill(0);
      for (const row of rows) {
        row.forEach((cell, i) => {
          const w = regularFont.widthOfTextAtSize(cell, fSize) + 8;
          colWidths[i] = Math.max(colWidths[i], Math.min(w, 120));
        });
      }

      const totalColWidth = colWidths.reduce((a, b) => a + b, 0);
      const availW = pgW - margin * 2;
      const scale = totalColWidth > availW ? availW / totalColWidth : 1;
      const scaledWidths = colWidths.map((w) => w * scale);

      let page = pdfDoc.addPage([pgW, pgH]);
      let y = pgH - margin;
      writtenSheets += 1;

      if (message.includeSheetTitle) {
        page.drawText(sheetName, { x: margin, y, size: fSize + 4, font: boldFont, color: rgb(0.05, 0.05, 0.05) });
        y -= fSize + 12;
      }

      rows.forEach((row, rowIdx) => {
        const isHeader = rowIdx === 0;
        const rowBackground = isHeader ? rgb(0.06, 0.06, 0.06) : rowIdx % 2 === 0 ? rgb(0.97, 0.97, 0.97) : rgb(1, 1, 1);
        const textColor = isHeader ? rgb(1, 1, 1) : rgb(0.1, 0.1, 0.1);
        const currentRowH = isHeader ? headerH : rowH;

        if (y - currentRowH < margin) {
          page = pdfDoc.addPage([pgW, pgH]);
          y = pgH - margin;
          if (rowIdx > 0 && rows[0]) {
            let hx = margin;
            page.drawRectangle({ x: margin, y: y - headerH, width: availW, height: headerH, color: rgb(0.06, 0.06, 0.06) });
            rows[0].forEach((cell, i) => {
              const cw = scaledWidths[i] ?? 60;
              page.drawText(cell.slice(0, 40), { x: hx + 3, y: y - headerH + 5, size: fSize, font: boldFont, color: rgb(1, 1, 1), maxWidth: cw - 6 });
              hx += cw;
            });
            y -= headerH;
          }
        }

        let x = margin;
        page.drawRectangle({ x: margin, y: y - currentRowH, width: availW, height: currentRowH, color: rowBackground });

        row.forEach((cell, i) => {
          const cw = scaledWidths[i] ?? 60;
          const text = cell.slice(0, 60);
          page.drawRectangle({ x, y: y - currentRowH, width: cw, height: currentRowH, borderColor: rgb(0.9, 0.91, 0.92), borderWidth: 0.5 });
          if (text) {
            page.drawText(text, { x: x + 3, y: y - currentRowH + 5, size: fSize, font: isHeader ? boldFont : regularFont, color: textColor, maxWidth: cw - 6 });
          }
          x += cw;
        });

        y -= currentRowH;
      });
    }

    if (writtenSheets === 0) throw new Error("Selected sheets contain no extractable cell data.");
    const pdfBytes = await pdfDoc.save();
    self.postMessage({ type: "DONE", jobId: message.jobId, result: pdfBytes }, { transfer: [pdfBytes.buffer] });
  } catch (error) {
    postError("jobId" in message ? message.jobId : 0, error);
  }
};
</file>

<file path="app/lib/pdf-processor.worker.ts">
import { PDFDocument, degrees, StandardFonts } from "pdf-lib";
import JSZip from "jszip";
import { COLOR_MAP as TEXT_COLOR_MAP, FONT_MAP, MARGIN_POINTS, PAGE_SIZES, wrapLines } from "./text-to-pdf";
import { COLOR_MAP as NUM_COLOR_MAP, MARGIN_MM, formatLabel, getCoordinates } from "./pdf-page-numbers";
import type {
  ProcessorInboundMessage,
  ProcessorOutboundMessage,
  ProcessorTaskOptions,
} from "./pdf-processor-protocol";

let currentJobId = -1;

function post(msg: ProcessorOutboundMessage, transfer?: Transferable[]) {
  postMessage(msg, { transfer: transfer || [] });
}

function mmToPoints(mm: number): number {
  return (mm * 72) / 25.4;
}

self.addEventListener("message", (event: MessageEvent<ProcessorInboundMessage>) => {
  const msg = event.data;

  if (msg.type === "CANCEL_PROCESS") {
    currentJobId = -1;
    return;
  }

  if (msg.type === "START_PROCESS") {
    currentJobId = msg.jobId;
    void handleTask(msg.jobId, msg.fileBytes, msg.task);
  }
});

async function handleTask(jobId: number, fileBytes: ArrayBuffer, task: ProcessorTaskOptions) {
  const checkCancel = () => { if (currentJobId !== jobId) throw new Error("Cancelled"); };

  try {
    let resultBytes: Uint8Array;
    let isZip = false;

    let sourceDoc: PDFDocument | undefined;
    if (fileBytes && fileBytes.byteLength > 0 && task.tool !== "text-to-pdf") {
      post({ type: "PROGRESS", jobId, percent: 10, message: "Loading PDF..." });
      sourceDoc = await PDFDocument.load(fileBytes, { ignoreEncryption: true });
      checkCancel();
    }

    switch (task.tool) {
      case "split": {
        if (!sourceDoc) throw new Error("No PDF loaded");
        const { mode, startPage, endPage, filename } = task.options;
        const total = sourceDoc.getPageCount();

        if (mode === "range") {
          const s = Math.max(1, startPage || 1) - 1;
          const e = Math.min(total, endPage || total) - 1;
          const indices: number[] = [];
          for (let i = s; i <= e; i++) indices.push(i);

          post({ type: "PROGRESS", jobId, percent: 30, message: "Extracting pages..." });
          const newPdf = await PDFDocument.create();
          const pages = await newPdf.copyPages(sourceDoc, indices);
          pages.forEach((page) => newPdf.addPage(page));

          checkCancel();
          
          post({ type: "PROGRESS", jobId, percent: 80, message: "Saving PDF..." });
          resultBytes = await newPdf.save();
        } else {
          // split all
          isZip = true;
          const zip = new JSZip();
          const baseName = filename.replace(/\.pdf$/i, "") || "document";

          for (let i = 0; i < total; i++) {
            checkCancel();
            post({ type: "PROGRESS", jobId, percent: Math.round(10 + (i / total) * 70), message: `Processing page ${i + 1} of ${total}...` });
            
            const newPdf = await PDFDocument.create();
            const [page] = await newPdf.copyPages(sourceDoc, [i]);
            newPdf.addPage(page);
            const pageBytes = await newPdf.save();
            zip.file(`${baseName}-page-${i + 1}.pdf`, pageBytes);
          }

          checkCancel();
          post({ type: "PROGRESS", jobId, percent: 85, message: "Generating ZIP archive..." });
          
          const zipBlob = await zip.generateAsync({ type: "uint8array" }, (metadata) => {
            if (currentJobId === jobId) post({ type: "PROGRESS", jobId, percent: Math.round(85 + metadata.percent * 0.15), message: "Compressing..." });
          });
          resultBytes = zipBlob;
        }
        break;
      }
      
      case "rotate": {
        if (!sourceDoc) throw new Error("No PDF loaded");
        const { mode, angle, page } = task.options;
        post({ type: "PROGRESS", jobId, percent: 30, message: "Applying rotation..." });
        
        if (mode === "all") {
          for (const p of sourceDoc.getPages()) {
            const current = p.getRotation().angle;
            p.setRotation(degrees((current + angle + 360) % 360));
          }
        } else if (page !== undefined && page > 0) {
          const p = sourceDoc.getPage(page - 1);
          const current = p.getRotation().angle;
          p.setRotation(degrees((current + angle + 360) % 360));
        }

        checkCancel();
        post({ type: "PROGRESS", jobId, percent: 80, message: "Saving PDF..." });
        resultBytes = await sourceDoc.save();
        break;
      }

      case "crop": {
        if (!sourceDoc) throw new Error("No PDF loaded");
        const { mode, singlePage, rangeStart, rangeEnd, margins } = task.options;
        const total = sourceDoc.getPageCount();
        const top = mmToPoints(margins.top);
        const bottom = mmToPoints(margins.bottom);
        const left = mmToPoints(margins.left);
        const right = mmToPoints(margins.right);

        post({ type: "PROGRESS", jobId, percent: 30, message: "Applying crops..." });
        
        for (let i = 0; i < total; i++) {
          let inScope = false;
          if (mode === "all") inScope = true;
          else if (mode === "single" && i + 1 === singlePage) inScope = true;
          else if (mode === "range" && rangeStart && rangeEnd && i + 1 >= rangeStart && i + 1 <= rangeEnd) inScope = true;

          if (inScope) {
            const p = sourceDoc.getPage(i);
            const { width, height } = p.getSize();
            const cropWidth = width - left - right;
            const cropHeight = height - bottom - top;
            if (cropWidth > 0 && cropHeight > 0) {
               p.setCropBox(left, bottom, cropWidth, cropHeight);
            }
          }
        }

        checkCancel();
        post({ type: "PROGRESS", jobId, percent: 80, message: "Saving PDF..." });
        resultBytes = await sourceDoc.save();
        break;
      }

      case "organize": {
        if (!sourceDoc) throw new Error("No PDF loaded");
        const { pages } = task.options;
        post({ type: "PROGRESS", jobId, percent: 20, message: "Building new PDF structure..." });
        
        const newDoc = await PDFDocument.create();
        
        for (let i = 0; i < pages.length; i++) {
          checkCancel();
          if (i % 10 === 0) {
            post({ type: "PROGRESS", jobId, percent: Math.round(20 + (i / pages.length) * 60), message: `Processing page ${i + 1} of ${pages.length}...` });
          }

          const entry = pages[i];
          if (entry.originalIndex === null) {
            newDoc.addPage([595, 842]);
          } else {
            const [copiedPage] = await newDoc.copyPages(sourceDoc, [entry.originalIndex]);
            if (entry.rotation !== 0) {
               copiedPage.setRotation(degrees(entry.rotation));
            }
            newDoc.addPage(copiedPage);
          }
        }

        checkCancel();
        post({ type: "PROGRESS", jobId, percent: 80, message: "Saving PDF..." });
        resultBytes = await newDoc.save();
        break;
      }
      
      case "text-to-pdf": {
        const { text, fontFamily, fontSize, pageSize, margin, alignment, colorKey } = task.options;
        post({ type: "PROGRESS", jobId, percent: 20, message: "Preparing document..." });
        
        const pdf = await PDFDocument.create();
        const font = await pdf.embedFont(FONT_MAP[fontFamily]);
        const color = TEXT_COLOR_MAP[colorKey] ?? TEXT_COLOR_MAP.black;

        const [pageWidth, pageHeight] = PAGE_SIZES[pageSize];
        const marginPt = MARGIN_POINTS[margin];
        const maxWidth = pageWidth - marginPt * 2;
        const lineHeight = fontSize * 1.45;
        
        post({ type: "PROGRESS", jobId, percent: 30, message: "Validating text encoding..." });
        
        const unsupportedMatch = text.match(/[^\x00-\xFF\u0152\u0153\u0178\u0192\u2013\u2014\u2018-\u201E\u2020-\u2022\u2026\u2030\u2039\u203A\u20AC\r\n\t]/);
        if (unsupportedMatch) {
          throw new Error(`Text contains unsupported character: "${unsupportedMatch[0]}". Please use standard Latin characters.`);
        }

        try {
          font.encodeText(text);
        } catch (e) {
          throw new Error("Text contains unsupported characters. Please use standard Latin characters.");
        }

        post({ type: "PROGRESS", jobId, percent: 40, message: "Processing text..." });
        const lines = wrapLines(text, font, fontSize, maxWidth);

        let page = pdf.addPage([pageWidth, pageHeight]);
        let y = pageHeight - marginPt - fontSize;

        for (let i = 0; i < lines.length; i++) {
          checkCancel();
          if (i % 100 === 0) {
            post({ type: "PROGRESS", jobId, percent: Math.round(40 + (i / lines.length) * 45), message: "Writing pages..." });
          }
          
          const line = lines[i];
          if (y < marginPt) {
            page = pdf.addPage([pageWidth, pageHeight]);
            y = pageHeight - marginPt - fontSize;
          }

          const textWidth = font.widthOfTextAtSize(line, fontSize);
          let x = marginPt;
          if (alignment === "center") {
            x = (pageWidth - textWidth) / 2;
          } else if (alignment === "right") {
            x = pageWidth - marginPt - textWidth;
          }

          page.drawText(line, { x, y, size: fontSize, font, color });
          y -= lineHeight;
        }

        checkCancel();
        post({ type: "PROGRESS", jobId, percent: 85, message: "Saving PDF..." });
        resultBytes = await pdf.save();
        break;
      }

      case "page-numbers": {
        if (!sourceDoc) throw new Error("No PDF loaded");
        const {
          position,
          format,
          startNumber,
          fontSize,
          colorKey,
          marginPreset,
          skipFirstPage,
          useCustomRange,
          rangeStart,
          rangeEnd,
        } = task.options;

        post({ type: "PROGRESS", jobId, percent: 20, message: "Preparing fonts..." });
        const font = await sourceDoc.embedFont(StandardFonts.Helvetica);
        const color = NUM_COLOR_MAP[colorKey];
        const marginPt = mmToPoints(MARGIN_MM[marginPreset]);
        const pageCount = sourceDoc.getPageCount();

        let displayNumber = startNumber;

        for (let i = 0; i < pageCount; i++) {
          checkCancel();
          if (i % 10 === 0) {
             post({ type: "PROGRESS", jobId, percent: Math.round(20 + (i / pageCount) * 60), message: `Numbering page ${i + 1} of ${pageCount}...` });
          }

          const pageIndex = i + 1;
          if (skipFirstPage && i === 0) continue;
          if (useCustomRange && (pageIndex < rangeStart || pageIndex > rangeEnd)) continue;

          const label = formatLabel(displayNumber, pageCount, format);
          const page = sourceDoc.getPage(i);
          const { width, height } = page.getSize();
          const rotationAngle = page.getRotation().angle;
          const normRot = ((rotationAngle % 360) + 360) % 360;

          // Compute visual dimensions
          const visualWidth = normRot === 90 || normRot === 270 ? height : width;
          const visualHeight = normRot === 90 || normRot === 270 ? width : height;

          const textWidth = font.widthOfTextAtSize(label, fontSize);
          
          const { x: visualX, y: visualY } = getCoordinates(position, visualWidth, visualHeight, textWidth, fontSize, marginPt);

          let unrotatedX = visualX;
          let unrotatedY = visualY;
          
          if (normRot === 90) {
            unrotatedX = width - visualY;
            unrotatedY = visualX;
          } else if (normRot === 180) {
            unrotatedX = width - visualX;
            unrotatedY = height - visualY;
          } else if (normRot === 270) {
            unrotatedX = visualY;
            unrotatedY = height - visualX;
          }

          page.drawText(label, { x: unrotatedX, y: unrotatedY, size: fontSize, font, color, rotate: degrees(0) });
          displayNumber += 1;
        }

        checkCancel();
        post({ type: "PROGRESS", jobId, percent: 85, message: "Saving PDF..." });
        resultBytes = await sourceDoc.save();
        break;
      }
      
      default:
        throw new Error("Unknown tool task.");
    }

    checkCancel();

    post({ type: "PROGRESS", jobId, percent: 100, message: "Done" });
    post({ type: "COMPLETE", jobId, result: resultBytes, isZip }, [resultBytes.buffer]);
  } catch (err) {
    if (currentJobId === jobId) {
      const msg = err instanceof Error ? err.message : "An unexpected error occurred.";
      post({ type: "ERROR", jobId, error: msg });
    }
  }
}
</file>

<file path="app/lib/pdfMerge.worker.ts">
/**
 * pdfMerge.worker.ts
 *
 * Dedicated Web Worker for the PDF merge pipeline.
 * Runs in a completely separate thread — the main UI thread is never blocked.
 *
 * Responsibilities
 * ────────────────
 * 1. Receive a START_MERGE message containing an ordered list of File objects.
 * 2. For each file:
 *    a. Read its ArrayBuffer  (File → ArrayBuffer, happens inside worker)
 *    b. Load via PDFDocument.load()  (pdf-lib)
 *    c. Bulk-copy all pages into the accumulator with a single copyPages() call.
 * 3. Serialise the accumulator with PDFDocument.save().
 * 4. Transfer the resulting Uint8Array back to the main thread (zero-copy).
 *
 * Cancellation
 * ────────────
 * Handled exclusively by worker.terminate() from the hook (useMergeWorker).
 * The worker itself has no cancel logic — a terminated worker simply stops.
 * This is the correct model for a stateless, single-use worker.
 *
 * Error handling
 * ──────────────
 * Any thrown error (including encryption, corruption) is caught at the top
 * level and posted as an ERROR message. The hook then terminates the worker.
 *
 * What is NOT done here (future phases)
 * ──────────────────────────────────────
 * • Memory batching for >N files
 * • Corrupted-PDF recovery / partial page rescue
 */

import { PDFDocument } from "pdf-lib";
import type {
  WorkerInboundMessage,
  WorkerOutboundMessage,
  MergeFileDescriptor,
  FileErrorStrategy,
} from "./merge-worker-protocol";

// ─── Constants ────────────────────────────────────────────────────────────────

/**
 * Estimated peak heap budget. When the pre-flight estimate exceeds this,
 * a MEMORY_WARNING is posted. Processing continues regardless.
 * 512 MB is conservative for modern desktop browsers; mobile may be lower.
 */
const MEMORY_LIMIT_BYTES = 512 * 1024 * 1024;

/**
 * Multiplier applied to the sum of raw file sizes to estimate peak heap.
 * Accounts for: raw ArrayBuffer (1×) + pdf-lib parsed object graph (~1.5×)
 * + accumulator page copies (~1×) = 3.5× total.
 */
const MEMORY_MULTIPLIER = 3.5;

// ─── Typed postMessage helper ─────────────────────────────────────────────────

function post(msg: WorkerOutboundMessage, transfer: Transferable[] = []): void {
  if (transfer.length > 0) {
    (self as unknown as Worker).postMessage(msg, transfer);
  } else {
    self.postMessage(msg);
  }
}

// ─── Memory estimation ────────────────────────────────────────────────────────

function estimateMemoryRequirement(files: MergeFileDescriptor[]): number {
  const totalRaw = files.reduce((sum, d) => sum + d.file.size, 0);
  return Math.round(totalRaw * MEMORY_MULTIPLIER);
}

function getAvailableHeap(): number | null {
  // performance.memory is a non-standard Chrome extension; may be undefined.
  const mem = (performance as unknown as Record<string, unknown>).memory as
    | { jsHeapSizeLimit: number; usedJSHeapSize: number }
    | undefined;
  if (!mem) return null;
  return mem.jsHeapSizeLimit - mem.usedJSHeapSize;
}

// ─── Core pipeline ────────────────────────────────────────────────────────────

async function readFileBytes(file: File): Promise<ArrayBuffer> {
  return file.arrayBuffer();
}

/**
 * Process every file sequentially, releasing references after each one.
 *
 * Memory strategy:
 * - rawBytes is nulled immediately after PDFDocument.load() succeeds.
 * - sourceDoc is nulled immediately after copyPages() completes.
 * - Both are released in a finally block so GC can reclaim even on error.
 *
 * @param files Ordered list of files to merge.
 * @param mergedDoc The accumulator PDFDocument (created once, reused across files).
 * @param strategy What to do when a file fails: skip it or abort the batch.
 * @returns Number of pages successfully copied across all files.
 */
async function processMergeQueue(
  files: MergeFileDescriptor[],
  mergedDoc: PDFDocument,
  strategy: FileErrorStrategy,
): Promise<number> {
  const totalFiles = files.length;
  let totalPagesCopied = 0;

  for (let fileIndex = 0; fileIndex < totalFiles; fileIndex++) {
    const descriptor = files[fileIndex];
    const oneBasedIndex = fileIndex + 1;

    // ── Empty-file guard ──────────────────────────────────────────────────────
    if (descriptor.file.size === 0) {
      post({
        type: "FILE_SKIPPED",
        fileId: descriptor.id,
        fileName: descriptor.file.name,
        fileIndex: oneBasedIndex,
        totalFiles,
        reason: "empty",
      });
      continue;
    }

    // ── FILE_STARTED ──────────────────────────────────────────────────────────
    post({
      type: "FILE_STARTED",
      fileId: descriptor.id,
      fileName: descriptor.file.name,
      fileIndex: oneBasedIndex,
      totalFiles,
    });

    // ── LOADING stage ─────────────────────────────────────────────────────────
    post({
      type: "PROGRESS_UPDATE",
      fileId: descriptor.id,
      stage: "loading",
      pagesDone: 0,
      totalPages: 0,
    });

    // Nullable refs — both released in finally to guarantee GC opportunity.
    let rawBytes: ArrayBuffer | null = null;
    let sourceDoc: PDFDocument | null = null;

    try {
      rawBytes = await readFileBytes(descriptor.file);

      try {
        sourceDoc = await PDFDocument.load(rawBytes, { ignoreEncryption: false });

        // ── COPYING_PAGES stage ─────────────────────────────────────────────────
        const pageIndices = sourceDoc.getPageIndices();
        const totalPages = pageIndices.length;

        post({
          type: "PROGRESS_UPDATE",
          fileId: descriptor.id,
          stage: "copying_pages",
          pagesDone: 0,
          totalPages,
        });

        // Single bulk call — pdf-lib resolves shared object references across
        // all pages together. Calling it N times for N pages is O(N²).
        const copiedPages = await mergedDoc.copyPages(sourceDoc, pageIndices);
        for (const page of copiedPages) {
          mergedDoc.addPage(page);
        }
        totalPagesCopied += copiedPages.length;

      } catch (loadErr) {
        const msg = loadErr instanceof Error ? loadErr.message : "";
        const isEncrypted =
          msg.toLowerCase().includes("encrypt") ||
          msg.toLowerCase().includes("password");
        const reason: "encrypted" | "corrupted" = isEncrypted ? "encrypted" : "corrupted";

        if (strategy === "skip") {
          post({
            type: "FILE_SKIPPED",
            fileId: descriptor.id,
            fileName: descriptor.file.name,
            fileIndex: oneBasedIndex,
            totalFiles,
            reason,
          });
          continue;
        }

        // strategy === "abort"
        throw new Error(
          isEncrypted
            ? `"${descriptor.file.name}" is password-protected and cannot be merged.`
            : `"${descriptor.file.name}" could not be parsed or processed. The file may be corrupted.`,
        );
      } finally {
        // Release the raw bytes immediately — sourceDoc holds everything it
        // needs; keeping rawBytes alive doubles peak memory for no benefit.
        rawBytes = null;
      }

    } finally {
      // Always release sourceDoc after copyPages, even if copyPages threw.
      sourceDoc = null;
      rawBytes = null; // defensive: cover early-exit paths
    }

    // ── FILE_COMPLETED ────────────────────────────────────────────────────────
    post({
      type: "FILE_COMPLETED",
      fileId: descriptor.id,
      fileIndex: oneBasedIndex,
      totalFiles,
    });
  }

  return totalPagesCopied;
}

// ─── Entry point ──────────────────────────────────────────────────────────────
// This worker is single-use. The hook (useMergeWorker) creates a fresh
// instance for every merge and terminates it immediately on completion,
// error, or cancellation. No CANCEL message is ever sent to this worker;
// the hook calls worker.terminate() directly, which is the correct and
// instantaneous cancellation mechanism for a stateless worker.

self.addEventListener("message", (event: MessageEvent<WorkerInboundMessage>) => {
  const msg = event.data;

  if (msg.type !== "START_MERGE") {
    return;
  }

  const strategy: FileErrorStrategy = msg.onFileError ?? "skip";

  void (async () => {
    try {
      // ── Pre-flight memory estimation ────────────────────────────────────────
      const estimatedBytes = estimateMemoryRequirement(msg.files);
      if (estimatedBytes > MEMORY_LIMIT_BYTES) {
        throw new Error(
          `Merge request exceeds the safe memory limit (~${Math.round(
            estimatedBytes / 1024 / 1024
          )} MB estimated, limit is ${Math.round(
            MEMORY_LIMIT_BYTES / 1024 / 1024
          )} MB). Please merge fewer or smaller PDF files.`
        );
      }

      const mergedDoc = await PDFDocument.create();

      const totalPagesCopied = await processMergeQueue(msg.files, mergedDoc, strategy);

      // ── Zero-pages guard ─────────────────────────────────────────────────────
      if (totalPagesCopied === 0) {
        post({ type: "ERROR", message: "No valid PDFs could be merged. All files were skipped or empty." });
        return;
      }

      // ── PIPELINE_STAGE: saving ───────────────────────────────────────────────
      post({ type: "PIPELINE_STAGE", stage: "saving" });

      const resultBytes = await mergedDoc.save({ useObjectStreams: true });

      post(
        {
          type: "COMPLETE",
          result: resultBytes,
          totalBytes: resultBytes.byteLength,
        },
        [resultBytes.buffer],
      );
    } catch (err) {
      const message =
        err instanceof Error
          ? err.message
          : "An unexpected error occurred during merge.";
      post({ type: "ERROR", message });
    }
  })();
});
